{
  "name": "limpide",
  "version": "1.0.0",
  "description": "A subtractive synthesizer in the browser that shows what each stage does to the sound.",
  "keywords": [
    "synthesizer",
    "web-audio",
    "webmidi",
    "music",
    "education"
  ],
  "author": "Guillaume Boillet",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc && vite build",
    "test:unit": "vitest run --project unit",
    "test:engine": "vitest run --project engine",
    "test:e2e": "playwright test",
    "typecheck": "tsc"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^4.1.12",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
